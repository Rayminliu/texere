.pytest_cache/
*.pyc

# 渲染产物（每次 --sample 重新生成）
check_pages/
sample_out.docx
sample_out.pdf

# validate.py 的证据包输出（临时验证产物）
evidence/
tmp_test.docx

# make_previews.py 的渲染中间产物
_previews_tmp/

# 仓库根目录的调试产物（_ 前缀约定）
/_*.docx
/_*.pdf
/_*.md

# examples/ 下的渲染产物
examples/**/*.docx
examples/**/*.pdf

# edit.py 的备份
*.bak.docx

# 基准模板由 pandoc 生成：pandoc --print-default-data-file reference.docx > ref_default.docx
ref_default.docx

# ruff 缓存
.ruff_cache/

# 本地参考用的第三方 ZCode 插件（Z.AI 专有许可，勿上传）
documents/

