.venv/
__pycache__/
.pytest_cache/
*.pyc

# 渲染产物（每次 --sample 重新生成）
check_pages/
sample_out.docx
sample_out.pdf
sample_test.docx

# validate.py 的证据包输出（临时验证产物；含 CI 同款目录命名变体）
evidence*/
# 例外：README 与 docs/showcase.md 首屏直接引的两张成品截图是入库资产，
# 重跑 validate 后应该能直接 git add，而不是被上一条静默吃掉。父目录被
# 忽略时文件级 ! 无效（git 不会下降进去），所以要先放行目录、再忽略其内容。
!evidence/
evidence/*
!evidence/page-001.png
!evidence/page-004.png
tmp_test.docx

# make_previews.py 的渲染中间产物
_previews_tmp/

# 仓库根目录的调试产物（_ 前缀约定）
/_*.docx
/_*.pdf
/_*.md

# examples/ 下的渲染产物
examples/**/*.docx
examples/**/*.pdf

# edit.py 的备份
*.bak.docx

# 基准模板由 pandoc 生成：pandoc --print-default-data-file reference.docx > ref_default.docx
ref_default.docx

# ruff 缓存
.ruff_cache/

# 本地参考用的第三方 ZCode 插件（Z.AI 专有许可，勿上传）
documents/

# ZCode 会话产物（规划草稿等）
.zcode/

# 系统与编辑器杂项
.DS_Store
Thumbs.db
desktop.ini
*.log

# coverage 运行数据
.coverage
htmlcov/

# ZCode 会话私有配置（审计者/平台相关，不入公开仓库）
.zcodeignore
